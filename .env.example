# OpenAI (Hackathon-Credits)
OPENAI_API_KEY=sk-...
# Vision-Modell für die Extraktion (A/B mit dem Eval-Skript testen, z. B. gpt-6-luna vs. gpt-6-sol)
OPENAI_VISION_MODEL=gpt-6-luna
# optional: none | minimal | low | medium | high  (weniger = schneller)
# OPENAI_REASONING_EFFORT=low

# optional: gleiche App auf Azure OpenAI (dann ist OPENAI_VISION_MODEL der Deployment-Name)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
